# ============================================================
# Credenciais do Telegram
# ============================================================
# API ID da sua aplicacao Telegram.
TELEGRAM_API_ID=12345678

# API hash da mesma aplicacao Telegram.
TELEGRAM_API_HASH=seu_telegram_api_hash

# StringSession autorizada da primeira conta usada pela API.
TELEGRAM_SESSION_STRING_BRYAN=sua_string_session_bryan

# StringSession autorizada da segunda conta usada pela API.
TELEGRAM_SESSION_STRING_BRYAN2=sua_string_session_bryan2

# ID numerico do grupo em que o servico de consultas responde.
TELEGRAM_GROUP_ID=-1002396715550

# ID numerico do grupo usado pelo adapter DataFlow.
GROUP_DATAFLOW=-1003340385645

# ID numerico do grupo usado pelo adapter Work Bot (TAMAKI).
GROUP_TAMAKI=-1002411246251

# ID numerico do grupo DON, compartilhado por Unknowrealbot, Unix Robot e VoidSearch.
GROUP_DON=-1002336848941

# ID numerico do grupo UNEN, usado como alternativa futura para VoidSearch.
GROUP_UNEN=-1003761336113

# ============================================================
# Worker Telegram, cache e limites operacionais
# ============================================================
# Timeout maximo, em segundos, para cada etapa de resposta do servico Telegram.
TELEGRAM_TIMEOUT=15

# Intervalo minimo, em segundos, entre consultas consecutivas na mesma conta.
RATE_LIMIT_INTERVAL=3.0

# Limite de requisicoes por IP em janela de 60 segundos para /api/*,
# exceto /api/health.
MAX_REQUESTS_PER_MINUTE=20

# TTL do cache em memoria, em horas. Reiniciar a API limpa o cache.
CACHE_TTL_HOURS=24

# Chave da API VoidAI usada pelo solver de captcha do Work Bot.
VOIDAI_API_KEY=

# ============================================================
# Seguranca da API
# ============================================================
# Chave principal exigida pelos endpoints protegidos.
# Se ficar vazia, os endpoints protegidos respondem 503.
API_SECRET_KEY=sua-api-key-aqui

# Chaves adicionais opcionais, separadas por virgula.
API_KEYS=

# ============================================================
# Execucao local / infraestrutura
# ============================================================
# Valores de referencia para sua operacao local.
# Observacao: o comando padrao do Uvicorn e o Dockerfile continuam usando
# 0.0.0.0:8000 explicitamente, entao ajuste tambem o comando de inicializacao
# se quiser mudar host ou porta.
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================
# CORS
# ============================================================
# Lista de origens permitidas separadas por virgula.
# Use * apenas em desenvolvimento.
CORS_ORIGINS=*