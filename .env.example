# Telegram API credentials
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_STRING_BRYAN=your_string_session_bryan
TELEGRAM_SESSION_STRING_BRYAN2=your_string_session_bryan2
TELEGRAM_GROUP_ID=-1002396715550

# Telegram worker and API rate limits
TELEGRAM_TIMEOUT=15
RATE_LIMIT_INTERVAL=3.0
MAX_REQUESTS_PER_MINUTE=20
CACHE_TTL_HOURS=24

# API security
API_SECRET_KEY=change-me
# Optional additional keys, separated by commas
API_KEYS=secondary-key-1,secondary-key-2

# Server
API_HOST=0.0.0.0
API_PORT=8000

# CORS
# Use * for development only. In production, set explicit origins separated by commas.
CORS_ORIGINS=*